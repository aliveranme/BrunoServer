# 环境变量（.env 文件示例，复制为 .env 后使用）
# Flask 服务器配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# 许可证配置
# 可选值: PRO_EDITION, GOLDEN_EDITION, ULTIMATE_EDITION
BRUNO_LICENSE_PLAN=ULTIMATE_EDITION

# 许可证类型: personal 或 organization
BRUNO_LICENSE_TYPE=personal

# 升级链接 URL（当用户点击"升级"时打开）
BRUNO_UPGRADE_URL=https://www.usebruno.com/pricing
